# Chat model used by the teaching assistant and its specialist sub-agents.
# Any Pydantic AI model string works, e.g. "openai:gpt-5.2" or "google:gemini-3-pro-preview".
TEACHING_ASSISTANT_MODEL=anthropic:claude-sonnet-4-6

# Embedding model used for RAG over course materials.
# Anthropic has no public embeddings endpoint, so this defaults to OpenAI's embedder
# even when the chat model above is Anthropic. Set OPENAI_API_KEY for this to work.
EMBEDDING_MODEL=openai:text-embedding-3-small

# Provider API keys - set whichever your TEACHING_ASSISTANT_MODEL and EMBEDDING_MODEL need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Where the RAG index and conversation memory are persisted.
TEACHING_ASSISTANT_DATA_DIR=./data
